# ==============================================================================
# Campus Grievance Addressal System (CGAS) - Environment Configuration Template
# Copy this file to '.env' and fill in your environment-specific credentials.
# NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Application Information
PROJECT_NAME="Campus Grievance Addressal System (CGAS)"
VERSION="1.0.0"
API_PREFIX="/api"

# MongoDB Database Connection
# Local MongoDB: mongodb://localhost:27017/cgas_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cgas_db?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017/cgas_db"
MONGODB_DB_NAME="cgas_db"
# Atlas Vector Search index on tickets.description_embedding
MONGODB_VECTOR_INDEX="ticket_description_vector_index"
VECTOR_SEARCH_CANDIDATES=100

# Optional semantic grievance matching via Gemini Embeddings.
# Configure this only in the backend/Vercel environment, never in frontend variables.
GEMINI_API_KEY=""
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSIONS=768

# JWT Authentication Security Key
# In production, generate a secure 256-bit random string (e.g. `openssl rand -hex 32`)
SECRET_KEY="cgas-development-secret-key-change-in-production-cs1207"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Security & Grievance Policies
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
OTP_VALIDITY_MINUTES=5
REOPEN_WINDOW_DAYS=7
MAX_UPLOAD_SIZE_BYTES=5242880

# Deployment & Initialization
# Set to 'true' on Vercel to automatically seed default categories and demo accounts if database is empty
AUTO_SEED="false"
